# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Synthesia (use the avatar's Interactive ID)
SYNTHESIA_API_KEY=your_synthesia_api_key
SYNTHESIA_AVATAR_ID=your_avatar_interactive_id

# Optional: custom Cartesia voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional
# TTS_MODEL=cartesia/sonic-3
# TTS_LANGUAGE=hi
# USE_SPRING=1
# SPRING_AVATAR_URL=http://127.0.0.1:8080/api/avatar/ask
# FAKE_BRAIN=1
